---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;

const events = [
  { title: "Bayview Birthday — Marisol at 50", type: "Social", guests: 90, img: `${base}/photos/bayview-1.jpg` },
  { title: "Patel Anniversary Reception", type: "Social", guests: 120, img: `${base}/photos/event-social.jpg` },
  { title: "Sunset on the Bay Fundraiser", type: "Nonprofit", guests: 180, img: `${base}/photos/harborview-1.jpg` },
  { title: "The Garcia Wedding", type: "Wedding", guests: 240, img: `${base}/photos/event-wedding.jpg` },
  { title: "Vista Holdings Holiday Party", type: "Corporate", guests: 320, img: `${base}/photos/event-corporate.jpg` },
  { title: "TechStart Annual Gala", type: "Corporate", guests: 450, img: `${base}/photos/ballroom-pacific-banquet.jpg` },
];

const testimonials = [
  { quote: "We toured five venues. Scott's was the only one where I could see exactly how the whole night would flow. Booked the same week.", name: "The Garcia Family", event: "Wedding · 240 guests" },
  { quote: "Our team has done galas all over the Bay. Scott's is now the only place we book — service is on another level.", name: "TechStart", event: "Annual Gala · 450 guests" },
  { quote: "We needed the Bayview Terrace at sunset for our photos. Scott's worked with us on timing and the result was magic.", name: "Patel Family", event: "Anniversary · 120 guests" },
];
---

<Layout title="Portfolio | Scott's Ballroom">
  <section class="bg-navy-deep pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">Portfolio</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        A look at past events.
      </h1>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="bg-paper border-l-4 border-gold p-5 mb-10 text-sm text-ink/80 leading-relaxed">
        <strong class="text-ink">Placeholder portfolio.</strong> Event names, photos, and testimonials below are sample content. Real event photos and quotes are pending from Kremo and the events team.
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {events.map((e) => (
          <div class="group">
            <div class="relative aspect-[4/3] overflow-hidden mb-4 bg-ink/10">
              <img src={e.img} alt={e.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              <span class="absolute top-3 left-3 bg-ink/85 text-cream text-[10px] uppercase tracking-widest font-semibold px-3 py-1.5">
                Placeholder
              </span>
            </div>
            <p class="text-gold-deep uppercase tracking-widest text-xs mb-1">{e.type} · {e.guests} guests</p>
            <h3 class="font-display text-xl text-ink leading-tight">{e.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-20 sm:py-28 border-y border-line">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">
      <div class="text-center mb-14">
        <p class="text-navy uppercase tracking-[0.3em] text-xs mb-4">From Our Hosts</p>
        <h2 class="font-display text-3xl sm:text-5xl text-ink">In their words.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8 sm:gap-10">
        {testimonials.map((t) => (
          <blockquote class="border-l-2 border-gold pl-6">
            <p class="font-display text-lg italic text-ink/85 leading-relaxed mb-5">"{t.quote}"</p>
            <footer class="text-sm">
              <p class="text-ink font-semibold">{t.name}</p>
              <p class="text-ink/60">{t.event}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy-deep py-20 sm:py-28 text-center text-cream">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <h2 class="font-display text-3xl sm:text-5xl mb-6 leading-tight">
        Your event could be next.
      </h2>
      <a href={url("/contact")} class="inline-block bg-gold text-navy-deep text-sm font-semibold uppercase tracking-widest px-10 py-4 hover:bg-cream transition mt-4">
        Start Planning →
      </a>
    </div>
  </section>
</Layout>
