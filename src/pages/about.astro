---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;

const featureImg = "https://static.wixstatic.com/media/56773e_e8eb6ec8755447599adca9d512c222c4~mv2.jpg/v1/fill/w_1920,h_1080,al_c,q_90/JK8A0325-1-6-scaled_edited.jpg";
const teamImg = "https://static.wixstatic.com/media/56773e_b9fbc93c14bd4b5b8ff904dfd944a196~mv2.jpg/v1/fill/w_1200,h_900/458690613_1500747403903587_2287569386930.jpg";
const includedImg = "https://static.wixstatic.com/media/56773e_2920d977ee68477c9c56ae32b1903e29~mv2.jpg/v1/fill/w_1200,h_900/seafood%20paella_edited.jpg";
---

<Layout title="About | Scott's Ballroom">
  <section class="bg-navy-deep pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">About</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        The Scott's standard,<br/>
        <span class="italic text-gold">elevated.</span>
      </h1>
    </div>
  </section>

  <!-- FEATURE IMAGE -->
  <section class="bg-navy-deep pb-0">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="aspect-[16/7] overflow-hidden shadow-2xl -mb-20 sm:-mb-28">
        <img src={featureImg} alt="Scott's Ballroom" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- INTRO COPY -->
  <section class="bg-cream-soft pt-32 sm:pt-40 pb-20 sm:pb-28">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 space-y-8 text-ink/80 leading-relaxed text-lg">
      <p>
        Scott's Ballroom is the event venue arm of Scott's Seafood San Jose —
        forty years of hospitality, expanded to fit a wedding for 300 or a
        gala for 700.
      </p>
      <p>
        Occupying the entire 7th floor of the <strong class="text-ink">Rotary Summit Center</strong>
        in downtown San Jose, the Ballroom offers 6,800 square feet of flexible
        event space across four distinct rooms — an indoor ballroom, an indoor
        foyer, and two outdoor terraces with full panoramic views of the
        San Jose skyline.
      </p>
    </div>
  </section>

  <!-- SPLIT: TEAM + COPY -->
  <section class="bg-paper py-20 sm:py-28 border-y border-line">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="aspect-[4/3] overflow-hidden shadow-2xl bg-ink/10">
        <img src={teamImg} alt="The Scott's Ballroom team" class="w-full h-full object-cover" />
      </div>
      <div>
        <p class="text-navy uppercase tracking-[0.3em] text-xs mb-4">One Team</p>
        <h2 class="font-display text-3xl sm:text-5xl text-ink mb-6 leading-tight">
          One roof. <span class="italic text-gold-deep">One team.</span>
        </h2>
        <p class="text-ink/75 leading-relaxed mb-5 text-lg">
          Every event runs under one roof: in-house culinary, beverage program,
          event coordination, A/V, and service staff.
        </p>
        <p class="text-ink/75 leading-relaxed text-lg">
          Our team handles the logistics so you handle the moment.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED with image -->
  <section class="bg-cream-soft py-20 sm:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="lg:order-2 aspect-[4/3] overflow-hidden shadow-2xl bg-ink/10">
        <img src={includedImg} alt="Event setup and service" class="w-full h-full object-cover" />
      </div>
      <div class="lg:order-1">
        <p class="text-navy uppercase tracking-[0.3em] text-xs mb-4">What's Included</p>
        <h2 class="font-display text-3xl sm:text-5xl text-ink mb-8 leading-tight">
          Every event includes.
        </h2>
        <div class="grid grid-cols-2 gap-x-6 gap-y-4 text-ink/80">
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>Tables (high & low)</p></div>
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>Chairs</p></div>
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>Dedicated event coordinator</p></div>
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>Full staffing (FOH & BOH)</p></div>
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>In-house culinary team</p></div>
          <div class="flex gap-3 items-start"><span class="text-gold-deep font-bold text-xl leading-none">·</span><p>Standard A/V setup</p></div>
        </div>
        <p class="mt-8 text-ink/60 italic text-sm">
          Add-ons available: florals, custom linens, dance floor, DJ, lighting upgrades.
          Preferred vendor partners on every category.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-deep py-20 sm:py-28 text-center text-cream">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">Looking Smaller?</p>
      <h2 class="font-display text-3xl sm:text-4xl mb-6 leading-tight">
        Want a more intimate space?
      </h2>
      <p class="text-cream/85 leading-relaxed mb-10">
        Scott's Seafood San Jose, our downtown restaurant, offers five private
        dining rooms from a 10-seat Chef's Table up to a 250-guest restaurant buyout.
      </p>
      <a href="https://squidly-inc.github.io/scotts-mockup/private-dining" class="inline-block border border-gold text-gold text-xs font-semibold uppercase tracking-widest px-8 py-3 hover:bg-gold hover:text-navy-deep transition">
        Restaurant Private Dining →
      </a>
    </div>
  </section>
</Layout>
