---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;

const heroVideo = `${base}/videos/ballroom-hero.mp4`;
const heroPoster = `${base}/videos/ballroom-hero-poster.jpg`;

const eventTypes = [
  {
    title: "Weddings",
    body: "Ballroom ceremonies, terrace cocktail hours, and skyline receptions.",
    href: url("/events") + "#weddings",
    img: `${base}/photos/event-wedding.jpg`,
  },
  {
    title: "Corporate",
    body: "Galas, conferences, holiday parties — fully serviced for up to 790+.",
    href: url("/events") + "#corporate",
    img: `${base}/photos/event-corporate.jpg`,
  },
  {
    title: "Social",
    body: "Milestone birthdays, anniversaries, nonprofits, fundraisers, and galas.",
    href: url("/events") + "#social",
    img: `${base}/photos/event-social.jpg`,
  },
];

const testimonials = [
  {
    quote: "Our event last Sunday was fantastic! Everyone enjoyed the venue and Kremo and the team did a great job! We are definitely interested in having our next celebration at Scott's Ballroom!",
    name: "JW House",
    event: "Non-profit, 200 guests",
  },
  {
    quote: "From start to finish at the event, all went well. I cannot sing the praises enough of how great Kremo has been to work with since we began exploring the possibility of the Scott's venue. Please know that the venue and your team will be highly recommended by me going forward.",
    name: "Brian",
    event: "High School Reunion, 150 guests",
  },
  {
    quote: "The Rotary Club of San Jose has the pleasure of working with Scott's Seafood, and they consistently exceed our expectations. Their team delivers high-quality meals that are fresh, flavorful, and professionally prepared. They are a valued partner and we look forward to continuing our partnership for years to come.",
    name: "Marie B., Rotary Club of San Jose",
    event: "Weekly Catering, 150 guests",
  },
  {
    quote: "Sammy & Kremo, thank you so much for your incredible partnership last week (and beyond). We really appreciate your flexibility on-site — our PICs were super happy with everything. Your team was awesome!",
    name: "Kaitlyn L., NVIDIA",
    event: "Corporate Conference, 350 guests",
  },
  {
    quote: "On behalf of the entire MEE Cmbre team, I would like to express our sincere gratitude for the outstanding support, service, and professionalism you provided throughout the planning and execution of our event. A very special thank you to Kremo and Lalo, who consistently demonstrated exceptional customer service, a willingness to help, and a genuine commitment to ensuring our event was successful.",
    name: "Melida A., MEE Cmbre",
    event: "Non-profit, 100 guests",
  },
];
---

<Layout
  title="Scott's Ballroom | Premier Event Venue in Downtown San Jose"
  description="7,163 sq ft event venue at the Rotary Summit Center. Weddings, corporate galas, and social events above the San Jose skyline."
  transparentHeader={true}
>
  <!-- HERO -->
  <section class="relative h-[100svh] min-h-[640px] w-full overflow-hidden bg-navy-deep">
    <video
      class="absolute inset-0 w-full h-full object-cover"
      src={heroVideo}
      poster={heroPoster}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
    <div class="absolute inset-0 bg-navy-deep/65"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-5 sm:px-8">
      <p class="fade-up text-gold uppercase tracking-[0.3em] text-xs sm:text-sm mb-4 sm:mb-6">
        The Rotary Summit Center · 7th Floor
      </p>
      <h1 class="fade-up-delay-1 text-cream font-display text-3xl leading-tight sm:text-6xl lg:text-7xl sm:leading-[1.05] max-w-3xl tracking-tight">
        Your story begins<br/>
        <span class="italic text-gold">above the skyline.</span>
      </h1>
      <p class="fade-up-delay-2 text-cream/85 mt-5 sm:mt-6 max-w-xl text-sm sm:text-lg leading-relaxed px-2">
        7,163 sq ft of elevated event space. Sweeping San Jose views.
        From intimate gatherings of 50 to receptions of 790+.
      </p>
      <div class="fade-up-delay-2 mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto">
        <a
          href={url("/contact")}
          class="bg-gold text-navy-deep text-sm font-semibold uppercase tracking-widest px-8 py-4 hover:bg-cream transition text-center"
        >
          Inquire Now
        </a>
        <a
          href={url("/spaces")}
          class="border border-cream/40 text-cream text-sm font-semibold uppercase tracking-widest px-8 py-4 hover:border-gold hover:text-gold transition text-center"
        >
          Explore Spaces
        </a>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="bg-cream-soft py-20 sm:py-28">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-navy uppercase tracking-[0.3em] text-xs mb-6">Discover Your Moment</p>
      <h2 class="font-display text-3xl sm:text-5xl text-ink mb-8 leading-tight">
        One venue.<br/>
        <span class="italic text-gold-deep">Four distinct spaces.</span>
      </h2>
      <p class="text-ink/75 leading-relaxed text-lg max-w-2xl mx-auto">
        Scott's Ballroom occupies the entire 7th floor of the Rotary Summit Center
        in downtown San Jose. Rent the whole floor or one room — every event
        gets the full Scott's culinary and hospitality standard.
      </p>
    </div>
  </section>

  <!-- EVENT TYPES -->
  <section class="bg-paper py-20 sm:py-28 border-y border-line">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="text-center mb-14 sm:mb-20">
        <p class="text-navy uppercase tracking-[0.3em] text-xs mb-4">Plan</p>
        <h2 class="font-display text-3xl sm:text-5xl text-ink">For every occasion.</h2>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {eventTypes.map((e) => (
          <a href={e.href} class="group block bg-cream-soft overflow-hidden hover:shadow-2xl transition">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={e.img} alt={e.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            </div>
            <div class="p-6 sm:p-8">
              <h3 class="font-display text-2xl text-ink mb-3">{e.title}</h3>
              <p class="text-ink/70 leading-relaxed mb-5 text-sm">{e.body}</p>
              <span class="text-navy text-xs uppercase tracking-widest font-semibold border-b border-navy pb-1 group-hover:text-gold-deep group-hover:border-gold-deep">
                Learn More →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-navy-deep py-20 sm:py-28 text-cream">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">
      <div class="text-center mb-14">
        <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">From Our Hosts</p>
        <h2 class="font-display text-3xl sm:text-5xl">Words that echo.</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
        {testimonials.map((t) => (
          <blockquote class="border-l-2 border-gold pl-6">
            <p class="font-display text-base sm:text-lg italic text-cream/95 leading-relaxed mb-5">"{t.quote}"</p>
            <footer class="text-sm">
              <p class="text-cream font-semibold">{t.name}</p>
              <p class="text-cream/60">{t.event}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-cream-soft py-20 sm:py-28 text-center">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <p class="text-navy uppercase tracking-[0.3em] text-xs mb-4">Ready?</p>
      <h2 class="font-display text-3xl sm:text-5xl text-ink mb-6 leading-tight">
        Let's plan your event.
      </h2>
      <p class="text-ink/70 leading-relaxed mb-10">
        Tell us about your event and our team will follow up with availability,
        pricing, and a custom proposal.
      </p>
      <a
        href={url("/contact")}
        class="inline-block bg-navy-deep text-cream text-sm font-semibold uppercase tracking-widest px-10 py-4 hover:bg-ink transition"
      >
        Start the Conversation
      </a>
    </div>
  </section>
</Layout>
